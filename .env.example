# Copy to .env and fill in from your Supabase project.
# Both are safe to ship in a client bundle — the anon key is protected by RLS.
# Restart the Expo dev server after editing; EXPO_PUBLIC_ vars are inlined at build time.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Not read by the app. Export it in your shell for the Supabase CLI:
#   export SUPABASE_ACCESS_TOKEN=sbp_...
