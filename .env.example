# Copy to .env and fill in from Supabase: Settings -> API Keys.
#
# The publishable key is designed to ship inside the client bundle. It is not a
# secret: row level security is what protects the data, and every table is
# scoped to people who have claimed one of the six roster identities.
#
# Anything prefixed VITE_ is compiled into the bundle, so never put a service
# role key or a Gemini key here. Those live in Supabase Edge Function secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
